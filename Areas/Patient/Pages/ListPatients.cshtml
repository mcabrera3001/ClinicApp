@page
@model ListPatientsModel
@{
    ViewData["Title"] = "List Patients";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<h2>List Patients</h2>

<table class="table">
    <thead>
        <tr>
            <th>UserName</th>
            <th>LastName</th>
            <th>Email</th>
            <th>PhoneNumber</th>
            <th>Address</th>
            <th>Actions</th> <!-- Nueva columna para las acciones -->
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Model.Patients!)
        {
            <tr>
                <td>@patient.UserName</td>
                <td>@patient.LastName</td>
                <td>@patient.Email</td>
                <td>@patient.PhoneNumber</td>
                <td>@patient.Address</td>
                <td>
                    <!-- Enlace para editar -->
                    <a asp-area="Patient" asp-page="/EditPatient" asp-route-id="@patient.Id" class="btn btn-primary btn-sm text-white">Edit</a>

                    <!-- Enlace para dar de baja -->
                    <a asp-area="Patient" asp-page="/DeletePatient" asp-route-id="@patient.Id" class="btn btn-danger btn-sm text-white">Delete</a>

                </td>
            </tr>
            <a href="Pages/EditPatient.cshtml">Master Pages Tutorials</a>
        }
    </tbody>
</table>
